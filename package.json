{
  "name": "shiftgrid",
  "version": "0.1.0-alpha",
  "private": true,
  "description": "Offline-first workforce scheduling — web and Windows desktop",
  "author": "ShiftGrid",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:pg": "node scripts/start-embedded-pg.mjs",
    "db:reset-demo": "node scripts/reset-demo.mjs",
    "backup": "tsx scripts/backup-now.mjs",
    "desktop": "electron .",
    "desktop:dist": "npm run build && electron-builder --win nsis",
    "release": "node scripts/release.mjs",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "build": {
    "appId": "app.shiftgrid.desktop",
    "productName": "ShiftGrid",
    "copyright": "Copyright © ShiftGrid",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "desktop/**/*",
      "public/**/*",
      "prisma/**/*",
      "scripts/backup-now.mjs",
      "src/lib/**/*",
      "src/app/**/*",
      "src/components/**/*",
      "src/types/**/*",
      "package.json",
      "next.config.ts",
      ".next/standalone/**/*",
      ".next/static/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "public",
        "to": "public"
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "public/brand/shiftgrid-logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ShiftGrid"
    }
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.103.2",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "electron-store": "^11.0.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.1"
  }
}
